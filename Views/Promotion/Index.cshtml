@{
    ViewData["Title"] = "Khuyến mãi & ưu đãi";
}

<div class="page-hero">
    <h1><i class="bi bi-ticket-perforated me-2"></i>KHUYẾN MÃI &amp; ƯU ĐÃI</h1>
    <p>Những ưu đãi hấp dẫn dành riêng cho tín đồ điện ảnh Galaxy</p>
</div>

<div class="container page-shell">
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="info-card">
                <div class="info-icon mb-2"><i class="bi bi-lightning-charge"></i></div>
                <span class="badge-status badge-paid mb-2 d-inline-block">THỨ 2 - THỨ 4</span>
                <h5 class="fw-bold">Ngày Vàng Xem Phim</h5>
                <p class="text-muted">Giảm 30% giá vé 2D &amp; 3D cho tất cả suất chiếu từ thứ 2 đến thứ 4.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="info-card">
                <div class="info-icon mb-2"><i class="bi bi-calendar-heart"></i></div>
                <span class="badge-status badge-paid mb-2 d-inline-block">CUỐI TUẦN</span>
                <h5 class="fw-bold">Combo Cuối Tuần</h5>
                <p class="text-muted">Mua vé thứ 6 - Chủ nhật tặng thêm 1 bắp ngô miễn phí khi đặt combo đôi.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="info-card">
                <div class="info-icon mb-2"><i class="bi bi-person-badge"></i></div>
                <span class="badge-status badge-paid mb-2 d-inline-block">HỌC SINH - SINH VIÊN</span>
                <h5 class="fw-bold">Ưu đãi HSSV</h5>
                <p class="text-muted">Giảm 20% giá vé cho học sinh, sinh viên vào các suất trước 17:00.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="info-card">
                <div class="info-icon mb-2"><i class="bi bi-phone"></i></div>
                <span class="badge-status badge-paid mb-2 d-inline-block">APP GALAXY</span>
                <h5 class="fw-bold">Đặt vé qua app</h5>
                <p class="text-muted">Đặt vé online qua app Galaxy Cinema nhận thêm 5% hoàn xu vào tài khoản.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="info-card">
                <div class="info-icon mb-2"><i class="bi bi-people"></i></div>
                <span class="badge-status badge-paid mb-2 d-inline-block">NHÓM 5+</span>
                <h5 class="fw-bold">Rủ nhóm xem phim</h5>
                <p class="text-muted">Mua từ 5 vé trở lên trong một giao dịch, giảm thêm 10% toàn bộ đơn.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="info-card">
                <div class="info-icon mb-2"><i class="bi bi-cake"></i></div>
                <span class="badge-status badge-paid mb-2 d-inline-block">SINH NHẬT</span>
                <h5 class="fw-bold">Vé miễn phí sinh nhật</h5>
                <p class="text-muted">Thành viên Galaxy được tặng 1 vé xem phim miễn phí trong tháng sinh nhật.</p>
            </div>
        </div>
    </div>

    <div class="alert alert-galaxy mt-4 d-flex align-items-center gap-3">
        <i class="bi bi-info-circle-fill fs-4"></i>
        <div>
            <strong>Điều kiện áp dụng:</strong> ưu đãi không áp dụng với suất chiếu đặc biệt và ngày lễ. Giá ưu đãi sẽ tự động hiển thị khi thanh toán tại quầy. Liên hệ <a asp-controller="Contact" asp-action="Index">trang liên hệ</a> để biết thêm chi tiết.
        </div>
    </div>
</div>