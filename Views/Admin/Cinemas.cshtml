@model List<Cinema>
@{
    ViewData["Title"] = "Quản lý rạp";
}

<div class="container page-shell">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="fw-bold mb-0" style="font-size:1.4rem"><i class="bi bi-building me-2" style="color:var(--accent-cyan)"></i>Quản lý rạp</h1>
        <a class="btn btn-cta btn-sm" asp-action="CreateCinema"><i class="bi bi-plus-lg me-1"></i>Thêm rạp</a>
    </div>

    <partial name="_AdminNav" />

    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="galaxy-panel p-0 overflow-auto">
        <table class="table table-galaxy mb-0">
            <thead>
                <tr>
                    <th>Tên chi nhánh</th>
                    <th>Địa chỉ</th>
                    <th>Điện thoại</th>
                    <th>Số phòng</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold">@c.Name</td>
                        <td>@c.Address</td>
                        <td>@c.Phone</td>
                        <td>@c.Rooms.Count</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-theme btn-sm" asp-action="EditCinema" asp-route-id="@c.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteCinema" method="post" asp-route-id="@c.Id" class="d-inline" onsubmit="return confirm('Xóa rạp @c.Name? Toàn bộ phòng, ghế sẽ bị xóa theo.');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger-ghost btn-sm" type="submit"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>