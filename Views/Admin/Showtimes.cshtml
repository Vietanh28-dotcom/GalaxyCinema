@model List<Showtime>
@{
    ViewData["Title"] = "Quản lý suất chiếu";
}

<div class="container page-shell">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="fw-bold mb-0" style="font-size:1.4rem"><i class="bi bi-calendar-week me-2" style="color:var(--accent-cyan)"></i>Quản lý suất chiếu</h1>
        <div class="d-flex gap-2 flex-wrap">
            <form asp-action="AutoGenerateShowtimes" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-theme btn-sm" type="submit" title="Tự động tạo suất chiếu cho tất cả phim theo ngày giờ hiện tại của Việt Nam">
                    <i class="bi bi-magic me-1"></i>Tự động tạo suất chiếu
                </button>
            </form>
            <a class="btn btn-cta btn-sm" asp-action="CreateShowtime"><i class="bi bi-plus-lg me-1"></i>Thêm suất chiếu</a>
        </div>
    </div>

    <partial name="_AdminNav" />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="galaxy-panel p-0 overflow-auto">
        <table class="table table-galaxy mb-0">
            <thead>
                <tr>
                    <th>Phim</th>
                    <th>Rạp / Phòng</th>
                    <th>Giờ chiếu</th>
                    <th>Giá vé</th>
                    <th>Loại phòng</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var st in Model)
                {
                    <tr>
                        <td class="fw-bold">@st.Movie.Title</td>
                        <td>@st.Room.Cinema.Name<br />@st.Room.Name</td>
                        <td>@st.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="color:var(--accent-gold)">@st.BasePrice.ToString("N0") ₫</td>
                        <td>
                            @switch (st.Room.RoomType)
                            {
                                case RoomType.IMAX: <span>IMAX</span> break;
                                case RoomType.Standard3D: <span>3D</span> break;
                                default: <span>2D</span> break;
                            }
                        </td>
                        <td>
                            @if (st.IsActive)
                            {
                                <span class="badge-status badge-paid">Đang chiếu</span>
                            }
                            else
                            {
                                <span class="badge-status badge-cancelled">Tạm khóa</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-theme btn-sm" asp-action="EditShowtime" asp-route-id="@st.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteShowtime" method="post" asp-route-id="@st.Id" class="d-inline" onsubmit="return confirm('Xóa suất chiếu này?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger-ghost btn-sm" type="submit"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>