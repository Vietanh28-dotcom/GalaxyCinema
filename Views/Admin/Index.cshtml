@{
    ViewData["Title"] = "Quản trị";
}

<div class="container page-shell">
    <div class="d-flex align-items-center gap-3 mb-1">
        <span class="hex-badge"><i class="bi bi-shield-lock"></i></span>
        <div>
            <h1 class="fw-bold mb-0" style="font-size:1.5rem">Bảng điều khiển</h1>
            <div class="text-muted small">Khu vực quản trị Galaxy Cinema</div>
        </div>
    </div>

    <partial name="_AdminNav" />

    <!-- Thống kê -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-receipt stat-icon"></i>
                <div class="stat-value">@ViewBag.TotalBookings</div>
                <div class="stat-label">Tổng đơn đặt vé</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-cash-coin stat-icon"></i>
                <div class="stat-value">@ViewBag.TotalRevenue.ToString("N0") ₫</div>
                <div class="stat-label">Tổng doanh thu</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-calendar-day stat-icon"></i>
                <div class="stat-value">@ViewBag.TodayRevenue.ToString("N0") ₫</div>
                <div class="stat-label">Doanh thu hôm nay</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-armchair stat-icon"></i>
                <div class="stat-value">@ViewBag.TotalSeatsSold</div>
                <div class="stat-label">Ghế đã bán</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="galaxy-panel p-4 h-100">
                <h5 class="font-display mb-3"><i class="bi bi-bar-chart me-2" style="color:var(--accent-cyan)"></i>Doanh thu theo ngày</h5>
                @if (ViewBag.RevenueByDay == null || ViewBag.RevenueByDay.Count == 0)
                {
                    <p class="text-muted">Chưa có dữ liệu.</p>
                }
                else
                {
                    var maxDay = 0m;
                    foreach (var d in ViewBag.RevenueByDay) { if (d.Total > maxDay) maxDay = (decimal)d.Total; }
                    foreach (var d in ViewBag.RevenueByDay)
                    {
                        var pct = maxDay > 0 ? (double)d.Total / (double)maxDay * 100 : 0;
                        <div class="revenue-bar-row">
                            <span class="rb-label">@(((DateTime)d.Date).ToString("dd/MM"))</span>
                            <div class="revenue-track"><div class="revenue-fill" style="width:@Math.Max(pct, 2)%"></div></div>
                            <span class="rb-val">@d.Total.ToString("N0") ₫</span>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="galaxy-panel p-4 h-100">
                <h5 class="font-display mb-3"><i class="bi bi-pie-chart me-2" style="color:var(--accent-cyan)"></i>Doanh thu theo phim</h5>
                @if (ViewBag.RevenueByMovie == null || ViewBag.RevenueByMovie.Count == 0)
                {
                    <p class="text-muted">Chưa có dữ liệu.</p>
                }
                else
                {
                    var maxMovie = 0m;
                    foreach (var m in ViewBag.RevenueByMovie) { if (m.Total > maxMovie) maxMovie = (decimal)m.Total; }
                    foreach (var m in ViewBag.RevenueByMovie)
                    {
                        var pct = maxMovie > 0 ? (double)m.Total / (double)maxMovie * 100 : 0;
                        <div class="revenue-bar-row">
                            <span class="rb-label">@m.MovieTitle</span>
                            <div class="revenue-track"><div class="revenue-fill" style="width:@Math.Max(pct, 2)%"></div></div>
                            <span class="rb-val">@m.Total.ToString("N0") ₫</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-4"><div class="info-card text-center"><div class="info-icon"><i class="bi bi-film"></i></div><div class="font-display fw-bold fs-4" style="color:var(--accent-gold)">@ViewBag.MovieCount</div><div class="text-muted">Phim</div></div></div>
        <div class="col-md-4"><div class="info-card text-center"><div class="info-icon"><i class="bi bi-building"></i></div><div class="font-display fw-bold fs-4" style="color:var(--accent-gold)">@ViewBag.CinemaCount</div><div class="text-muted">Chi nhánh rạp</div></div></div>
        <div class="col-md-4"><div class="info-card text-center"><div class="info-icon"><i class="bi bi-shield-check"></i></div><div class="font-display fw-bold fs-4" style="color:var(--accent-gold)">1</div><div class="text-muted">Tài khoản quản trị</div></div></div>
    </div>
</div>