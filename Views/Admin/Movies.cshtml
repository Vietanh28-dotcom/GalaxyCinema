@model List<Movie>
@{
    ViewData["Title"] = "Quản lý phim";
}

<div class="container page-shell">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="fw-bold mb-0" style="font-size:1.4rem"><i class="bi bi-film me-2" style="color:var(--accent-cyan)"></i>Quản lý phim</h1>
        <a class="btn btn-cta btn-sm" asp-action="CreateMovie"><i class="bi bi-plus-lg me-1"></i>Thêm phim</a>
    </div>

    <partial name="_AdminNav" />

    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="galaxy-panel p-0 overflow-auto">
        <table class="table table-galaxy mb-0">
            <thead>
                <tr>
                    <th>Poster</th>
                    <th>Tên phim</th>
                    <th>Thể loại</th>
                    <th>Thời lượng</th>
                    <th>Rating</th>
                    <th>Trạng thái</th>
                    <th>Khởi chiếu</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td style="width:52px">
                            <img src="@(string.IsNullOrEmpty(m.PosterUrl) ? "/img/misc/poster-placeholder.svg" : m.PosterUrl)" alt="@m.Title" style="width:40px;height:58px;object-fit:cover;border-radius:6px" />
                        </td>
                        <td class="fw-bold">@m.Title</td>
                        <td>@m.Genre</td>
                        <td>@m.DurationMinutes'</td>
                        <td style="color:var(--accent-gold)">@(m.Rating > 0 ? m.Rating.ToString("0.0") : "-")</td>
                        <td>
                            @if (m.Status == MovieStatus.NowShowing)
                            {
                                <span class="badge-status badge-paid">Đang chiếu</span>
                            }
                            else
                            {
                                <span class="badge-status badge-pending">Sắp chiếu</span>
                            }
                        </td>
                        <td>@m.ReleaseDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-theme btn-sm" asp-action="EditMovie" asp-route-id="@m.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteMovie" method="post" asp-route-id="@m.Id" class="d-inline" onsubmit="return confirm('Xóa phim @m.Title?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger-ghost btn-sm" type="submit"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>