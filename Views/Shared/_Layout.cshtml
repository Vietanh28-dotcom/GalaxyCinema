<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Galaxy Cinema</title>
    <link rel="icon" type="image/svg+xml" href="/img/misc/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@500;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "admin-area" : "")">
    <canvas id="starfield" aria-hidden="true"></canvas>
    <div class="nebula nebula-1" aria-hidden="true"></div>
    <div class="nebula nebula-2" aria-hidden="true"></div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark galaxy-navbar fixed-top">
            <div class="container">
                <a class="navbar-brand galaxy-logo" asp-controller="Home" asp-action="Index">
                    <span class="logo-shield" aria-hidden="true">
                        <svg viewBox="0 0 48 48" width="34" height="34" fill="none">
                            <defs>
                                <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
                                    <stop offset="0%" stop-color="#7b2ff7"/>
                                    <stop offset="100%" stop-color="#00d4ff"/>
                                </linearGradient>
                            </defs>
                            <path d="M24 2 42 10v14c0 11-8 19-18 22C14 43 6 35 6 24V10L24 2Z" fill="url(#lg)" opacity="0.25" stroke="#00d4ff" stroke-width="2"/>
                            <path d="M24 13l3.5 7 7.5 1.2-5.4 5.3 1.2 7.6L24 30.5l-6.8 3.6 1.2-7.6L13 21.2l7.5-1.2 3.5-7Z" fill="#ffd700" stroke="#ffd700" stroke-width="1"/>
                        </svg>
                    </span>
                    <span class="logo-text">GALAXY<span class="logo-sub">CINEMA</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item"><a class="nav-link nav-galaxy @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-stars me-1"></i>Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link nav-galaxy @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movie" ? "active" : "")" asp-controller="Movie" asp-action="Index"><i class="bi bi-film me-1"></i>Phim</a></li>
                        <li class="nav-item"><a class="nav-link nav-galaxy @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cinema" ? "active" : "")" asp-controller="Cinema" asp-action="Index"><i class="bi bi-building me-1"></i>Rạp chiếu</a></li>
                        <li class="nav-item"><a class="nav-link nav-galaxy @(ViewContext.RouteData.Values["controller"]?.ToString() == "Promotion" ? "active" : "")" asp-controller="Promotion" asp-action="Index"><i class="bi bi-ticket-perforated me-1"></i>Khuyến mãi</a></li>
                        <li class="nav-item"><a class="nav-link nav-galaxy @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index"><i class="bi bi-envelope me-1"></i>Liên hệ</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link nav-galaxy" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock me-1"></i>Quản trị</a></li>
                        }
                        <partial name="_LoginPartial" />
                        @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Admin")
                        {
                            <li class="nav-item ms-lg-2">
                                <button id="themeToggle" type="button" class="btn btn-ghost btn-sm" title="Đổi giao diện sáng/tối" aria-label="Đổi giao diện sáng/tối">
                                    <i class="bi bi-sun" id="themeIcon"></i>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="portal-in" role="main">
        @RenderBody()
    </main>

    <footer class="galaxy-footer">
        <div class="footer-hex" aria-hidden="true"></div>
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand d-flex align-items-center gap-2 mb-3">
                        <span class="logo-shield">
                            <svg viewBox="0 0 48 48" width="26" height="26" fill="none">
                                <path d="M24 2 42 10v14c0 11-8 19-18 22C14 43 6 35 6 24V10L24 2Z" fill="#7b2ff7" opacity="0.3" stroke="#00d4ff" stroke-width="2"/>
                                <path d="M24 13l3.5 7 7.5 1.2-5.4 5.3 1.2 7.6L24 30.5l-6.8 3.6 1.2-7.6L13 21.2l7.5-1.2 3.5-7Z" fill="#ffd700"/>
                            </svg>
                        </span>
                        <span class="logo-text">GALAXY<span class="logo-sub">CINEMA</span></span>
                    </div>
                    <p class="text-muted">Hệ thống rạp chiếu phim lấy cảm hứng từ vũ trụ điện ảnh. Trải nghiệm phim ảnh đỉnh cao dưới bầu trời sao, cùng công nghệ IMAX, 3D và âm thanh sống động.</p>
                    <div class="socials d-flex gap-2">
                        <a href="https://facebook.com/galaxycine.vn" target="_blank" rel="noopener" aria-label="Facebook" class="social-btn"><i class="bi bi-facebook"></i></a>
                        <a href="https://instagram.com/galaxycine.vn" target="_blank" rel="noopener" aria-label="Instagram" class="social-btn"><i class="bi bi-instagram"></i></a>
                        <a href="https://youtube.com/@@galaxyplayonline" target="_blank" rel="noopener" aria-label="YouTube" class="social-btn"><i class="bi bi-youtube"></i></a>
                        <a href="https://tiktok.com/@@galaxyplay.vn" target="_blank" rel="noopener" aria-label="TikTok" class="social-btn"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-title">Khám phá</h5>
                    <ul class="footer-links list-unstyled">
                        <li><a asp-controller="Movie" asp-action="Index">Phim đang chiếu</a></li>
                        <li><a asp-controller="Cinema" asp-action="Index">Hệ thống rạp</a></li>
                        <li><a asp-controller="Promotion" asp-action="Index">Khuyến mãi &amp; ưu đãi</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Liên hệ &amp; hỗ trợ</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a asp-controller="Admin" asp-action="Index">Khu vực quản trị</a></li>
                        }
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-title">Liên hệ</h5>
                    <ul class="footer-contact list-unstyled">
                        <li><i class="bi bi-geo-alt me-2"></i>247 Hoàng Văn Thụ, Q. Tân Bình, TP.HCM</li>
                        <li><i class="bi bi-geo-alt me-2"></i>Số 2 Nguyễn Trãi, Q. Thanh Xuân, Hà Nội</li>
                        <li><i class="bi bi-telephone me-2"></i>1900 5555 66 (9:00 - 22:00)</li>
                        <li><i class="bi bi-envelope me-2"></i>hotro@galaxycinema.vn</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom border-top pt-3 pb-4 d-flex flex-wrap justify-content-between gap-2">
                <span class="text-muted small">© @VnTime.Now.Year Galaxy Cinema. Thiết kế lấy cảm hứng vũ trụ - không sử dụng logo, nhân vật có bản quyền.</span>
                <span class="text-muted small"><i class="bi bi-shield-check me-1"></i>Đặt vé online an toàn - mã QR hợp lệ tại quầy</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>