@model SelectComboViewModel
@{
    ViewData["Title"] = "Chọn combo";
    ViewData["CurrentStep"] = 3;
    ViewData["MovieId"] = Model.Showtime.MovieId;
    var showtime = Model.Showtime;
}

<div class="container page-shell">
    <h1 class="fw-bold" style="font-size:1.5rem"><i class="bi bi-popcorn me-2" style="color:var(--accent-cyan)"></i>Combo bắp nước (tuỳ chọn)</h1>
    <div class="text-muted mb-4">
        <i class="bi bi-film me-1"></i>@showtime.Movie.Title &nbsp;|&nbsp;
        <i class="bi bi-clock me-1"></i>@showtime.StartTime.ToString("dd/MM/yyyy HH:mm")
    </div>

    <partial name="_Stepper" />

    <form method="post" asp-action="SelectCombo">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            @foreach (var combo in Model.Combos)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="combo-card">
                        <div class="combo-img">
                            <img src="@(string.IsNullOrEmpty(combo.ImageUrl) ? "/img/misc/combo-placeholder.svg" : combo.ImageUrl)" alt="@combo.Name" />
                        </div>
                        <div class="combo-body">
                            <h5 class="fw-bold" style="font-size:0.98rem">@combo.Name</h5>
                            <p class="text-muted small flex-grow-1">@combo.Description</p>
                            <div class="d-flex align-items-center justify-content-between mt-2">
                                <div class="combo-price">@combo.Price.ToString("N0") ₫</div>
                                <div class="combo-qty" data-combo-id="@combo.Id">
                                    <button type="button" class="btn-qty" data-act="minus" aria-label="Giảm"><i class="bi bi-dash"></i></button>
                                    <input type="number" class="qty-input" value="0" min="0" max="20" aria-label="Số lượng" />
                                    <button type="button" class="btn-qty" data-act="plus" aria-label="Tăng"><i class="bi bi-plus"></i></button>
                                </div>
                            </div>
                            <input type="hidden" name="quantities[@combo.Id]" value="0" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="galaxy-panel p-4 mt-4">
            <h5 class="font-display mb-3"><i class="bi bi-armchair me-2" style="color:var(--accent-cyan)"></i>Ghế đã chọn</h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var s in Model.SelectedSeats)
                {
                    <span class="badge-status badge-paid">@s.Code @* @((Model.Showtime.BasePrice * s.PriceMultiplier).ToString("N0"))đ *@</span>
                }
            </div>
            <div class="summary-item mt-3"><span class="text-muted">Tiền ghế</span><strong style="color:var(--accent-gold)">@Model.SeatTotal.ToString("N0") ₫</strong></div>
            <div class="summary-item"><span class="text-muted">Combo</span><strong>Tính ở bước sau</strong></div>

            <div class="d-flex gap-2 mt-4">
                <a class="btn btn-ghost" asp-action="SelectSeats" asp-route-showtimeId="@showtime.Id">Quay lại chọn ghế</a>
                <button type="submit" class="btn btn-cta"><i class="bi bi-arrow-right me-1"></i>Điền thông tin khách hàng</button>
            </div>
        </div>
    </form>
</div>