@page
@model GalaxyCinema.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    var returnUrl = Request.Query["returnUrl"].ToString();
}

<div class="auth-hero" aria-hidden="true"></div>
<div class="container page-shell auth-page-container d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 200px);">
    <div class="auth-card p-4 w-100" style="max-width:480px;">
        <h2 class="text-center display-6 font-display mb-3" style="color:var(--accent-red)">ĐĂNG KÝ</h2>

        @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@returnUrl" />

            <div class="mb-3">
                <label for="Input_Email" class="form-label text-muted">Email</label>
                <input id="Input_Email" name="Input.Email" type="email" class="form-control form-control-lg input-glass" />
            </div>

            <div class="mb-3">
                <label for="Input_Password" class="form-label text-muted">Mật khẩu</label>
                <input id="Input_Password" name="Input.Password" type="password" class="form-control form-control-lg input-glass" />
            </div>

            <div class="mb-3">
                <label for="Input_ConfirmPassword" class="form-label text-muted">Xác nhận mật khẩu</label>
                <input id="Input_ConfirmPassword" name="Input.ConfirmPassword" type="password" class="form-control form-control-lg input-glass" />
            </div>

            <button type="submit" class="btn btn-primary-red w-100 mb-3">Đăng ký</button>

            <div class="text-center text-muted small">Đã có tài khoản? <a asp-area="Identity" asp-page="/Account/Login" class="link-highlight">Đăng nhập</a></div>
        </form>
    </div>
</div>
